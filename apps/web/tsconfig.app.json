{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["vite/client"],
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["vite-env.d.ts", "src"],
  "exclude": ["node_modules"]
}
